{
  "name": "batchframe",
  "version": "1.0.0",
  "description": "High-performance digital asset management and image culling tool",
  "main": "src/main.js",
  "homepage": "./",
  "author": "",
  "license": "ISC",
  "scripts": {
    "react-start": "cross-env BROWSER=none react-scripts start",
    "react-build": "react-scripts build",
    "electron-start": "electron .",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "build": "npm run react-build && electron-builder",
    "build:win": "npm run react-build && electron-builder --win --x64",
    "build:mac": "npm run react-build && electron-builder --mac",
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "browser": "react-scripts start"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-is-dev": "^2.0.0",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "qrcode": "^1.5.4",
    "trash": "^8.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^27.3.11",
    "electron-builder": "^24.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "react-window": "^2.2.7",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "extends": null,
    "appId": "com.user.batchframe",
    "productName": "BatchFrame",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json",
      "!**/__pycache__/**",
      "!**/*.map"
    ],
    "extraResources": [
      "ai_scan.py",
      "ai_detect.py",
      "ai_duplicates.py",
      "remove_bg.py",
      "remove_subs.py",
      "find_source.py",
      "cluster_images.py",
      "requirements.txt",
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.photography",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BatchFrame",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "allowScripts": {
    "electron@27.3.11": true
  }
}
