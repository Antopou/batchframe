{
  "name": "batchframe",
  "version": "1.0.0",
  "description": "High-performance digital asset management and image culling tool",
  "main": "src/main.js",
  "homepage": "./",
  "author": "",
  "license": "ISC",
  "scripts": {
    "react-start": "cross-env BROWSER=none react-scripts start",
    "react-build": "react-scripts build",
    "electron-start": "electron .",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "build": "npm run react-build && electron-builder",
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "browser": "react-scripts start"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-is-dev": "^2.0.0",
    "googleapis": "^173.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "react-window": "^2.2.7",
    "trash": "^8.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^27.3.11",
    "electron-builder": "^24.4.0",
    "wait-on": "^7.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "extends": null,
    "appId": "com.user.batchframe",
    "productName": "BatchFrame",
    "files": [
      "src/**/*",
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "portable"
    },
    "directories": {
      "output": "dist"
    }
  },
  "allowScripts": {
    "electron@27.3.11": true
  }
}
